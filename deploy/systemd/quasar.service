[Unit]
Description=Quasar school schedule tracker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/NAS/Private/school-schedule-tracker

[Service]
Type=simple
WorkingDirectory=/srv/NAS/Private/school-schedule-tracker
ExecStart=%h/.local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3003
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
