# Copy to .env.local for local development. Never commit credentials.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google email of the project owner. No client-side role can grant access.
OWNER_EMAIL=
# Local disk, not a network filesystem. WAL SQLite needs reliable file locking.
DATABASE_PATH=./data/whatsnext.sqlite
