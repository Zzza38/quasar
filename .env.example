# Copy to .env.local for local development. Never commit credentials.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google email of the project owner. No client-side role can grant access.
OWNER_EMAIL=
# Recommended: the owner's Google account ID (the OIDC `sub`), shown in /admin until it is set. With it, owner
# access also requires that exact Google account, so the email address alone can never grant it.
OWNER_GOOGLE_SUB=
# Local disk, not a network filesystem. WAL SQLite needs reliable file locking.
DATABASE_PATH=./data/quasar.sqlite
# Optional. The token from Google Search Console's "HTML tag" verification method (the content="…" value);
# it is printed as a <meta name="google-site-verification"> tag on every page. Verifying the domain with a
# DNS record instead needs nothing here.
GOOGLE_SITE_VERIFICATION=

# Optional browser push reminders. Generate a VAPID key pair with web-push;
# use the same keys for the app and background worker. Keep private keys secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Optional timetable photo scanning through any OpenAI-compatible chat API.
# One scan may carry up to three photos (for example both halves of a wide
# timetable), sent together in a single request, so pick a vision model.
# Leave SCAN_API_URL or SCAN_MODEL empty to hide the feature. Examples:
#   OpenAI      SCAN_API_URL=https://api.openai.com/v1      SCAN_MODEL=gpt-6-luna
#   OpenRouter  SCAN_API_URL=https://openrouter.ai/api/v1   SCAN_MODEL=openai/gpt-6-luna
#   DeepSeek    SCAN_API_URL=https://api.deepseek.com/v1    SCAN_MODEL=deepseek-chat
#   Ollama      SCAN_API_URL=http://localhost:11434/v1      SCAN_MODEL=qwen3-vl:8b   (no key needed)
SCAN_API_URL=
SCAN_API_KEY=
SCAN_MODEL=
# Optional reasoning effort for models that accept it (none, minimal, low, medium, high, xhigh).
# Low is plenty for reading a timetable and keeps scans fast and cheap.
SCAN_MODEL_REASONING=
# Optional sampling temperature (0 to 2). Left empty, none is sent and the provider default applies.
# Set 0 for steadier answers only on models that accept it (DeepSeek, Ollama); OpenAI reasoning models
# reject a non-default temperature while they reason, which would fail every scan.
SCAN_MODEL_TEMPERATURE=
